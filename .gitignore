# Git ignore rules for agent-telegram & telegram-bot-manager
# Zero-Leak Secret Security: Never commit tokens or credentials

# Telegram Bot tokens & local cache
.agent/
.agents/
telegram_bot.json
telegram_vault.json
.telegram_cache/

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Specific
.DS_Store
Thumbs.db
Desktop.ini
